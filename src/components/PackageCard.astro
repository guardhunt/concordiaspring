---
/**
 * PackageCard
 * Displays a single package tier with pricing and CTA.
 */
interface Props {
  title: string;
  classCount: number;
  cost: number;
  perClassCost: number;
  validityDays?: number;
  description: string;
  highlight?: boolean;
  onPurchase?: string;
}

const {
  title,
  classCount,
  cost,
  perClassCost,
  validityDays,
  description,
  highlight = false,
  onPurchase = '#purchase-form',
} = Astro.props;
---

<article
  class:list={[
    'relative flex flex-col rounded-xl border bg-card p-8 transition-transform duration-200',
    highlight
      ? 'border-2 border-primary-400 lg:scale-105 lg:z-10 shadow-sm'
      : 'border-border hover:-translate-y-0.5',
  ]}
>
  {
    highlight && (
      <span
        class="absolute -top-3 left-1/2 -translate-x-1/2 inline-flex items-center rounded-full bg-primary-500 px-4 py-1 text-xs font-medium text-background"
      >
        Most Popular
      </span>
    )
  }
  <h3 class="font-serif text-xl font-semibold text-foreground">{title}</h3>
  <p class="mt-4 font-serif text-3xl font-semibold text-foreground">
    ${cost}
    <span class="ml-2 text-base font-sans font-normal text-muted-foreground">
      (${perClassCost}/class)
    </span>
  </p>
  {
    validityDays && (
      <p class="mt-2 text-sm text-muted-foreground">Valid for {validityDays} days</p>
    )
  }
  <p class="mt-1 text-sm text-muted-foreground">
    {classCount} {classCount === 1 ? 'class' : 'classes'}
  </p>
  <p class="mt-4 text-sm text-foreground leading-relaxed flex-1">{description}</p>
  <a
    href={onPurchase}
    class="mt-6 inline-flex w-full items-center justify-center rounded-xl bg-primary-500 px-4 py-3 text-sm font-medium text-background hover:bg-primary-600 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
  >
    Purchase
    <span aria-hidden="true" class="ml-1">→</span>
  </a>
</article>
