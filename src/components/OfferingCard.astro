---
/**
 * OfferingCard
 * Displays a single offering in the offerings grid.
 */
interface Props {
  title: string;
  type: 'class' | 'workshop' | 'series';
  teacher: string;
  cost: number;
  duration: string;
  schedule: string;
  slug: string;
  featured?: boolean;
}

const { title, type, teacher, cost, duration, schedule, slug, featured = false } = Astro.props;

const typeLabels = {
  class: 'Class',
  workshop: 'Workshop',
  series: 'Series',
};
---

<article
  class="rounded-xl border border-border bg-card p-8 flex flex-col gap-4 transition-transform duration-200 hover:-translate-y-0.5"
>
  <div class="flex flex-wrap items-center gap-2">
    <span
      class="inline-flex items-center rounded-full bg-primary-200 px-3 py-1 text-xs font-medium text-primary-700"
    >
      {typeLabels[type]}
    </span>
    {
      featured && (
        <span class="inline-flex items-center rounded-full bg-accent-500 px-3 py-1 text-xs font-medium text-background">
          Featured
        </span>
      )
    }
  </div>
  <h3 class="font-serif text-2xl font-semibold text-foreground">
    <a href={`/offerings/${slug}`} class="hover:text-primary transition-colors">
      {title}
    </a>
  </h3>
  <p class="text-sm text-muted-foreground">with {teacher}</p>
  <p class="text-sm text-foreground">
    {schedule} · {duration}
  </p>
  <p class="text-lg font-medium text-primary">${cost} per class</p>
  <a
    href={`/offerings/${slug}`}
    class="mt-auto inline-flex items-center text-sm font-medium text-primary hover:text-primary/80 transition-colors"
  >
    Learn more
    <span aria-hidden="true" class="ml-1">→</span>
  </a>
</article>
