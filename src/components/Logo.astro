---
/**
 * Logo Component
 *
 * ConcordiaSpring brand wordmark.
 * Used consistently across Header, Footer, and layouts.
 *
 * @example
 * ```astro
 * <Logo />
 * <Logo showText={false} />
 * <Logo size="lg" />
 * ```
 */
interface Props {
  /** Show the "ConcordiaSpring" text */
  showText?: boolean;
  /** Size variant */
  size?: 'sm' | 'md' | 'lg';
  /** Additional CSS classes */
  class?: string;
}

const { showText = true, size = 'md', class: className = '' } = Astro.props;

const textSizeClasses = {
  sm: 'text-sm',
  md: 'text-lg',
  lg: 'text-xl',
};
---

<a href="/" class:list={['flex items-center', className]}>
  {
    showText && (
      <span class:list={['font-serif font-semibold tracking-tight text-primary', textSizeClasses[size]]}>
        ConcordiaSpring
      </span>
    )
  }
</a>
