---
/**
 * Footer Component
 *
 * ConcordiaSpring site footer with navigation and tagline.
 *
 * @example
 * ```astro
 * <Footer />
 * <Footer variant="fullWidth" />
 * ```
 */
interface Props {
  /** Layout variant - boxed (default) or fullWidth */
  variant?: 'boxed' | 'fullWidth';
}

const { variant = 'boxed' } = Astro.props;

const footerLinks = [
  { href: '/offerings', label: 'Offerings' },
  { href: '/packages', label: 'Packages' },
  { href: '/contact', label: 'Contact' },
];

const containerClass =
  variant === 'fullWidth' ? 'w-full px-4' : 'container max-w-5xl mx-auto px-4 sm:px-6';
---

<footer class="border-t border-border/60 bg-muted">
  <div class:list={[containerClass, 'py-12']}>
    <div class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
      <!-- Brand -->
      <div class="max-w-sm">
        <p class="font-serif text-lg font-semibold text-foreground">ConcordiaSpring</p>
        <p class="mt-2 text-sm text-muted-foreground">
          Yoga & Somatics · Asheville, NC
        </p>
      </div>

      <!-- Links -->
      <nav aria-label="Footer navigation">
        <ul class="flex flex-wrap gap-x-8 gap-y-2">
          {
            footerLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-muted-foreground hover:text-foreground transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <!-- Copyright -->
    <div class="mt-10 pt-8 border-t border-border/60 text-center text-sm text-muted-foreground">
      <p>&copy; {new Date().getFullYear()} ConcordiaSpring. All rights reserved.</p>
    </div>
  </div>
</footer>
