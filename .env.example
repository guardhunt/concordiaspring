# Copy this file to .env and fill in your values
# .env is gitignored — never commit real secrets

BREVO_API_KEY=your_brevo_api_key
WEB3FORMS_ACCESS_KEY=your_web3forms_access_key
VENMO_USERNAME=your_venmo_username
CAL_WEBHOOK_SECRET=your_cal_webhook_secret
PUBLIC_CAL_USERNAME=your_calcom_username

# Browser-exposed (contacts-only scoped key recommended)
PUBLIC_BREVO_API_KEY=your_brevo_contacts_only_key
PUBLIC_BREVO_INTERESTED_LIST_ID=your_interested_list_id

# Serverless booking confirmation (Netlify)
BREVO_TEMPLATE_ID=your_booking_confirmation_template_id
BREVO_STUDENTS_LIST_ID=your_students_list_id
